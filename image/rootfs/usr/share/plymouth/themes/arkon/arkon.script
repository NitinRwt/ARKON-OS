// ARKON OS Plymouth boot animation
// Dark background, centered glowing "ARKON" wordmark, pulse animation

Window.SetBackgroundTopColor(0.03, 0.03, 0.08);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.03);

// ── Logo / wordmark ──────────────────────────────────────────────────────────

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(0);

// ── Progress bar ─────────────────────────────────────────────────────────────

bar_height = 3;
bar_width  = 320;
bar_x      = Window.GetWidth()  / 2 - bar_width / 2;
bar_y      = Window.GetHeight() / 2 + 80;

bar_bg = Image.CreateAt(bar_width, bar_height);
bar_bg.Rectangle(0, 0, bar_width, bar_height, 0.15, 0.15, 0.25, 1.0);
bar_bg_sprite = Sprite(bar_bg);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);
bar_bg_sprite.SetOpacity(0);

bar_fill = Image.CreateAt(1, bar_height);
bar_fill.Rectangle(0, 0, 1, bar_height, 0.30, 0.60, 1.0, 1.0);
bar_fill_sprite = Sprite(bar_fill);
bar_fill_sprite.SetX(bar_x);
bar_fill_sprite.SetY(bar_y);
bar_fill_sprite.SetOpacity(0);

// ── State ────────────────────────────────────────────────────────────────────

progress    = 0;
tick        = 0;
fade_in     = 0;

// ── Animation loop ───────────────────────────────────────────────────────────

fun refresh_callback() {
    tick++;

    // Fade everything in over first ~60 ticks
    if (fade_in < 1.0) {
        fade_in = Math.Min(1.0, tick / 60.0);
        logo.sprite.SetOpacity(fade_in);
        bar_bg_sprite.SetOpacity(fade_in * 0.6);
        bar_fill_sprite.SetOpacity(fade_in);
    }

    // Pulse logo opacity: gentle breathing effect
    pulse = 0.80 + 0.20 * Math.Sin(tick / 30.0);
    logo.sprite.SetOpacity(fade_in * pulse);

    // Animate progress bar width toward current progress value
    target_w = Math.Max(1, Math.Floor(progress * bar_width));
    bar_fill_sprite.SetImage(
        Image.CreateAt(target_w, bar_height)
            .Rectangle(0, 0, target_w, bar_height, 0.30, 0.60, 1.0, 1.0)
    );
}

Plymouth.SetRefreshFunction(refresh_callback);

// ── Boot progress (Plymouth BootProgress event) ───────────────────────────────

fun boot_progress_callback(duration, percent_done) {
    progress = percent_done;
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

// ── Password dialog (disk unlock) ─────────────────────────────────────────────

dialog_opacity = 0;

fun display_password_callback(prompt, bullets) {
    dialog_opacity = 1;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
